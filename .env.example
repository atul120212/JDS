# Copy to .env and adjust. All values are optional.

# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg://user:pass@localhost:5432/jd_collector
DATABASE_URL=sqlite:///data/jd_collector.db

SOURCES_FILE=config/sources.yaml
CATALOG_FILE=config/catalog.yaml
LOG_DIR=logs
LOG_LEVEL=INFO

# When set, every API endpoint except /health and / requires the header X-API-Key
API_KEY=

# Optional Slack-compatible webhook that receives failure/anomaly alerts
ALERT_WEBHOOK_URL=

# HTTP behaviour
# Multiple user agents are separated by "||"; they are rotated per request
USER_AGENTS=JDCollectorBot/1.0 (+https://example.com/jd-collector)
# Comma-separated proxy URLs, rotated round-robin (empty = direct connection)
PROXIES=
REQUEST_TIMEOUT=20
MAX_RETRIES=4
DEFAULT_RATE_LIMIT_SECONDS=1.0
CACHE_TTL_SECONDS=300
RESPECT_ROBOTS=true

# Pipeline
MAX_WORKERS=4
STORE_RAW=true
MIN_DESCRIPTION_LENGTH=30
